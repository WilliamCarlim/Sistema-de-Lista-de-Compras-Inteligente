datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  lists        ShoppingList[]
  categories   Category[]
  products     Product[]
}

model ShoppingList {
  id          String         @id @default(uuid())
  title       String
  description String?
  budget      Float?
  status      String         @default("ACTIVE") // ACTIVE, ARCHIVED, COMPLETED
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       ListItem[]
}

model Category {
  id        String     @id @default(uuid())
  name      String
  color     String?    // Hex code para tag
  createdAt DateTime   @default(now())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  Product[]
  items     ListItem[]

  @@unique([name, userId])
}

model Product {
  id           String     @id @default(uuid())
  name         String
  defaultPrice Float?
  defaultUnit  String     @default("un") // un, kg, g, L, ml, pacote, caixa
  createdAt    DateTime   @default(now())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId   String?
  category     Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items        ListItem[]

  @@unique([name, userId])
}

model ListItem {
  id           String        @id @default(uuid())
  name         String
  quantity     Float         @default(1)
  unit         String        @default("un") // un, kg, g, L, ml, pacote
  price        Float?        // Preço unitário estimado ou real
  bought       Boolean       @default(false)
  notes        String?
  createdAt    DateTime      @default(now())
  listId       String
  list         ShoppingList  @relation(fields: [listId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  categoryId   String?
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}
